# قالب أسماء فقط؛ لا يحتوي أسرارًا أو قيم تشغيل.
# Node.js 22.12+ ضمن 22.x كما في package.json.
# التطبيق يقرأ APP_PORT وليس PORT.
NODE_ENV=
APP_NAME=
APP_URL=
APP_PORT=
CLIENT_URL=

# على الخادم تُستخدم DB_HOST/DB_NAME/DB_USER/DB_PASSWORD (انظر deploy/docker-compose.yml).
# DIRECT_DATABASE_URL مخصص للتهيئة والترحيلات على اتصال مباشر غير pooler.
# لا تضبط روابط الإنتاج في بيئة الاختبارات.
DATABASE_URL=
DIRECT_DATABASE_URL=
DB_POOL_MAX=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=
AUTO_MIGRATE=

# JWT_SECRET مطلوب في الإنتاج بطول 32 حرفًا أو أكثر.
# حافظ على مفاتيح المشروع الموجود؛ تغييرها قد يقطع الجلسات أو فك تشفير التكاملات.
JWT_SECRET=
JWT_EXPIRES_IN=
# Admin-area session length (AYK-240), default 12h; the site and app use SITE_SESSION_EXPIRES_IN (default 365d).
ADMIN_SESSION_EXPIRES_IN=
ENCRYPTION_KEY=
API_RATE_LIMIT=

UPLOAD_MAX_SIZE=
UPLOAD_DIR=
# AYK-251: server copies (one per CPU core to use). Empty or 1 = one process. Each copy opens up to
# DB_POOL_MAX database connections. Not yet tried on the production server.
APP_WORKERS=
# AYK-248: user media (chat and request attachments, voice notes, video clips) in a private Cloudflare
# R2 bucket instead of the database. All four set = on; empty = off (development, tests).
# Key: Object Read & Write on this bucket only, WITHOUT a client IP filter (phones open its links).
R2_MEDIA_ENDPOINT=
R2_MEDIA_BUCKET=
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
MAP_PROVIDER=
GOOGLE_MAPS_API_KEY=

# خدمات اختيارية، لا تعبئها قبل إعداد المزود فعليًا.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_FROM=
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=
NAFATH_ALLOWED_HOSTS=

# لإنشاء أول مدير في قاعدة تطوير فارغة فقط عند الحاجة؛ ليست بيانات المدير الحالي.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=


# هذه أسماء الواجهة للمرجع؛ Vite يقرأ ملف البيئة داخل client.
VITE_API_URL=
VITE_REALTIME_MODE=


# المكالمات (LiveKit مستضاف ذاتيًا). القيم الفعلية في deploy/docker-compose.yml و/opt/aykdmh/.env على الخادم.
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# خلف بروكسي (Caddy) لاستخدام عنوان الزائر الحقيقي في حد الطلبات.
TRUST_PROXY=

# خادم Nominatim بديل (اختياري). الافتراضي OpenStreetMap العام.
NOMINATIM_URL=

# نمط بلاط الخرائط (اختياري). الافتراضي OpenFreeMap.
VITE_MAP_STYLE_URL=

# تنبيهات تطبيق أندرويد (Firebase، مفتاح حساب الخدمة بترميز base64) وتطبيق آيفون (APNs). على الخادم في /opt/aykdmh/.env فقط.
FCM_SERVICE_ACCOUNT_B64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=sa.aykdmh.app
APNS_KEY=

# ترجمة المحادثات والطلبات: Microsoft Translator (الفئة المجانية F0). بدونه تُستخدم MyMemory المجانية الأبطأ.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global

# Optional tuning, documented in AYK-240 (defaults shown):
# SITE_SESSION_EXPIRES_IN=365d   site and app session length
# APNS_SANDBOX=                  1 only for development builds of the iPhone app
# CALL_CAPACITY_VIDEO=100
# CALL_CAPACITY_AUDIO=500
# NOMINATIM_MIN_INTERVAL_MS=1100
# SEO_INDEX_HTML=                path of the site's index.html when it is not in the default place
