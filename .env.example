# قالب أسماء فقط؛ لا يحتوي أسرارًا أو قيم تشغيل.
# Node.js 22.12+ ضمن 22.x كما في package.json.
# التطبيق يقرأ APP_PORT وليس PORT.
NODE_ENV=
APP_NAME=
APP_URL=
APP_PORT=
CLIENT_URL=

# على الخادم تُستخدم DB_HOST/DB_NAME/DB_USER/DB_PASSWORD (انظر deploy/docker-compose.yml).
# DIRECT_DATABASE_URL مخصص للتهيئة والترحيلات على اتصال مباشر غير pooler.
# لا تضبط روابط الإنتاج في بيئة الاختبارات.
DATABASE_URL=
DIRECT_DATABASE_URL=
DB_POOL_MAX=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=
AUTO_MIGRATE=

# JWT_SECRET مطلوب في الإنتاج بطول 32 حرفًا أو أكثر.
# حافظ على مفاتيح المشروع الموجود؛ تغييرها قد يقطع الجلسات أو فك تشفير التكاملات.
JWT_SECRET=
JWT_EXPIRES_IN=
ENCRYPTION_KEY=
API_RATE_LIMIT=

UPLOAD_MAX_SIZE=
UPLOAD_DIR=
MAP_PROVIDER=
GOOGLE_MAPS_API_KEY=

# خدمات اختيارية، لا تعبئها قبل إعداد المزود فعليًا.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_FROM=
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=
NAFATH_ALLOWED_HOSTS=

# لإنشاء أول مدير في قاعدة تطوير فارغة فقط عند الحاجة؛ ليست بيانات المدير الحالي.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=


# هذه أسماء الواجهة للمرجع؛ Vite يقرأ ملف البيئة داخل client.
VITE_API_URL=
VITE_REALTIME_MODE=

# متغير بناء اختياري في بيئة shell لتجنب تنزيل CUDA غير المستخدم.
ONNXRUNTIME_NODE_INSTALL_CUDA=

# المكالمات (LiveKit مستضاف ذاتيًا). القيم الفعلية في deploy/docker-compose.yml و/opt/aykdmh/.env على الخادم.
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# خلف بروكسي (Caddy) لاستخدام عنوان الزائر الحقيقي في حد الطلبات.
TRUST_PROXY=

# خادم Nominatim بديل (اختياري). الافتراضي OpenStreetMap العام.
NOMINATIM_URL=

# نمط بلاط الخرائط (اختياري). الافتراضي OpenFreeMap.
VITE_MAP_STYLE_URL=
